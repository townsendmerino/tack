# tack serve's socket (DESIGN §8.2), a systemd user unit on nobara. The first connection to it starts
# tack-serve.service, which loads the model on demand; tack serve exits after its idle timeout and the socket stays.
[Unit]
Description=tack serve: the on-demand model server's socket

[Socket]
# The serving machine's tailnet address and tack's port; tailnet only. 100.64.0.1 is a placeholder: put your own
# machine's address here (`tailscale ip -4`). FreeBind lets it bind before tailscaled has the address.
ListenStream=100.64.0.1:8091
FreeBind=true

[Install]
WantedBy=sockets.target
